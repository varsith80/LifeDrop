PORT=5000

# MongoDB URI (leave empty or set to 'memory' to automatically use embedded in-memory MongoDB)
MONGO_URI=mongodb://localhost:27017/hemolinkDB

# JWT Secrets
JWT_SECRET=hemolink_jwt_access_secret_key_change_in_production
JWT_REFRESH_SECRET=hemolink_jwt_refresh_secret_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Firebase Cloud Messaging (Optional for simulated push)
FIREBASE_PROJECT_ID=hemolink-emergency
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@hemolink.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=

# Maps API (Optional for geolocation)
MAPS_API_KEY=

# Environment
NODE_ENV=development

# Client URLs
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
